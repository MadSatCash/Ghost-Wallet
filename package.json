{
  "name": "bch-wallet",
  "version": "0.10.0",
  "description": "Wallet de escritorio BCH: simple, rapida y segura",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node test/wallet.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "author": "MadSatCash",
  "build": {
    "appId": "cash.munia.ghostwallet",
    "productName": "Ghost Wallet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/main/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/main/icon.png",
      "category": "Finance"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/main/icon.png",
      "category": "public.app-category.finance"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@bitauth/libauth": "^3.0.0",
    "@electrum-cash/network": "^4.2.2",
    "bip39": "^3.1.0",
    "bitcore-lib-cash": "^10.10.5",
    "qrcode-generator": "^2.0.4",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "tar": "^7.5.22",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
